# Environment Variables — Patient Registration System
# Copy this file to .env and fill in your real values.
# ⚠️  NEVER put real keys in this file — it gets committed to GitHub.

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─────────────────────────────────────────────
# Vapi.ai (https://vapi.ai → Dashboard → API Keys)
# ─────────────────────────────────────────────
VAPI_API_KEY=your_vapi_private_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here

# ─────────────────────────────────────────────
# Google Gemini (https://aistudio.google.com/app/apikey)
# ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────
# Database (SQLite — no setup needed)
# ─────────────────────────────────────────────
DB_PATH=./data/patients.db

# ─────────────────────────────────────────────
# Security — Webhook Secret
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Paste the SAME value here AND in Vapi Dashboard → Server URL → Secret field
# ─────────────────────────────────────────────
VAPI_WEBHOOK_SECRET=your_generated_secret_here
